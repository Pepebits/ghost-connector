# Ghost Connector configuration.
#
# Easiest: run `ghost-connector setup` (or `npm run dev -- setup`), which asks
# for everything, tests each connection and writes this file for you. Every
# option can also be changed later in the panel, under Settings.
#
# By hand: copy this file to `.env` (repo clone) or `config.env` (package or
# Docker) and fill in the REQUIRED block. Everything else is optional and
# already holds its default: an empty value also means "the default".


# ============================================================================
#  REQUIRED
# ============================================================================

# ---------- 👻 Ghost ----------
# Your site, and an Admin API Key: Ghost Admin → Settings → Integrations →
# Add custom integration. (The Content API Key won't do: it can't write.)
GHOST_API_URL=https://example.com
GHOST_ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GHOST_API_VERSION=v6.0

# ---------- 🤖 AI ----------
# deepseek (default) | anthropic (Claude) | openai-compatible (OpenAI, OpenRouter, Groq, Ollama…)
AI_PROVIDER=deepseek
AI_API_KEY=sk-...
# Empty = the provider's defaults (deepseek-flash at https://api.deepseek.com/beta;
# claude-sonnet-5-5 at https://api.anthropic.com). Both required with openai-compatible,
# e.g. https://api.openai.com/v1 · https://openrouter.ai/api/v1 · http://127.0.0.1:11434/v1
AI_MODEL=
AI_BASE_URL=

# ---------- ✍️ Your blog ----------
# What it's about: topic, audience, language and tone. Every agent reads it.
SITE_CONTEXT="Technology, software and AI blog in Spanish for a technical audience."


# ============================================================================
#  OPTIONAL
# ============================================================================

# ---------- 🤖 AI: models, limits and cost ----------
# A different model per agent (empty = AI_MODEL).
AI_MODEL_WRITER=
AI_MODEL_SEO=
AI_MODEL_IMAGE=
AI_MODEL_RESOLVE=
AI_MAX_TOKENS=8000
# Daily cap in USD (last 24 h): no new AI work starts once it's reached. 0 = no cap.
AI_DAILY_BUDGET_USD=0
# Prices in USD per million tokens, model=input/output, comma-separated, e.g.
# gpt-4o-mini=0.15/0.6. Without a price the cost shows as "unknown"; deepseek-flash is built in.
AI_PRICES=

# ---------- 📝 Which drafts and how they're written ----------
# Ghost filter for the drafts to process (always limited to drafts), e.g. status:draft+tag:ai
DRAFT_FILTER=status:draft
MAX_POSTS_PER_RUN=5
CONCURRENCY=2
TARGET_WORD_COUNT=1200
# How the body is sent to Ghost: html (default) or lexical.
CONTENT_STRATEGY=html
# Let the SEO agent change the slug of a draft.
ALLOW_SLUG_CHANGE=false
# The writer may link 1-3 related posts already published on your blog.
INTERNAL_LINKS=true
# Nightly plan of drafts never planned, at this local time (HH:MM, e.g. 07:00). Empty = off.
# It only plans, never applies; at most AUTO_PLAN_MAX per night, within AI_DAILY_BUDGET_USD.
AUTO_PLAN_TIME=
AUTO_PLAN_MAX=3

# ---------- 🖼️ Images ----------
# Order the sources are tried in: the next one is used when one has no key,
# runs out of quota or finds nothing. Attribution always goes in the caption.
IMAGE_SOURCES_ORDER=unsplash,pixabay,pexels,openverse,wikimedia

# Unsplash (50 requests/hour on a demo app): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=ghost-connector

# Pixabay (100 requests/minute): https://pixabay.com/api/docs/ (log in first)
PIXABAY_API_KEY=

# Pexels (200 requests/hour): https://www.pexels.com/api/
PEXELS_API_KEY=

# Openverse: Creative Commons photos, no key (20 requests/minute, 200/day).
# Register an app in Settings (or set its credentials here) for more quota.
OPENVERSE_ENABLED=true
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Licenses allowing commercial use and modification: cc0, pdm, by, by-sa.
OPENVERSE_LICENSES=cc0,pdm,by

# Wikimedia Commons (Wikipedia's images), no key. Same license choice as Openverse.
WIKIMEDIA_ENABLED=true
WIKIMEDIA_LICENSES=cc0,pdm,by

# ---------- 💡 Ideas: search data (read-only) ----------
# Google Search Console: the property as shown there (e.g. sc-domain:example.com)
# and the path to a service account's JSON key with access to it.
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT=
# Bing Webmaster Tools: site URL (e.g. https://example.com/) and API key
# (Bing Webmaster → Settings → API access).
BING_SITE_URL=
BING_API_KEY=

# ---------- 🔗 Reading sources ----------
# GitHub token (no scopes needed) to read github.com sources with more quota
# (60 → 5000 requests/hour).
GITHUB_TOKEN=

# ---------- 🖥️ Panel and server ----------
# Interface language: en or es (any folder in src/i18n/locales). Doesn't change your posts.
UI_LANGUAGE=en
# Public address when served behind a proxy or tunnel, e.g. https://ghost.example.com
PUBLIC_URL=
# Plan B for scripts only: a fixed token that logs in as the owner WITHOUT
# password or 2FA (24+ random characters). Leave it unset.
WEB_SESSION_TOKEN=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Data folder (plans, index, edited prompts). Default: .data in a repo clone,
# ~/.config/ghost-connector/data when installed; fixed in Docker. Uncomment to
# change it (left commented because an empty value would not mean the default).
# DATA_DIR=.data

# ---------- 🧪 Development only ----------
# Draft used by the dev scripts (npm run test:writer, test:image);
# npm run seed:test-post creates one and prints its id.
TEST_POST_ID=
