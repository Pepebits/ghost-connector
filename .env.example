# ---------- Ghost ----------
GHOST_API_URL=https://example.com
GHOST_ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GHOST_API_VERSION=v6.0

# ---------- AI (subagents: writing, SEO, image plan) ----------
# deepseek (default) | anthropic (Claude) | openai-compatible (OpenAI, OpenRouter, Groq, Ollama...)
AI_PROVIDER=deepseek
AI_API_KEY=sk-...
# Empty = provider defaults (deepseek-flash and https://api.deepseek.com/beta;
# claude-sonnet-5-5 and https://api.anthropic.com). Required with openai-compatible,
# e.g. https://api.openai.com/v1 · https://openrouter.ai/api/v1 · http://127.0.0.1:11434/v1
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=8000
# Daily cap in USD on AI spending (last 24 h). 0 = no cap
AI_DAILY_BUDGET_USD=0
# Optional: a different model per agent (falls back to AI_MODEL)
AI_MODEL_WRITER=
AI_MODEL_SEO=
AI_MODEL_IMAGE=
AI_MODEL_RESOLVE=
# Prices in USD per million tokens: model=input/output, comma-separated.
# Without a price, cost shows as "unknown". deepseek-flash is built in.
AI_PRICES=
# The old DEEPSEEK_* variables still work, but print a warning on startup.

# ---------- Image sources ----------
# Order they're tried in (moves to the next one if there's no key, quota runs out or nothing is found)
IMAGE_SOURCES_ORDER=unsplash,pixabay,pexels,openverse,wikimedia

# ---------- Unsplash ----------
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=my-app

# ---------- Pixabay (free key, issued on sign-up) ----------
# Key at https://pixabay.com/api/docs/ (log in first) -- 100 requests/minute.
PIXABAY_API_KEY=

# ---------- Pexels (fallback when Unsplash runs out of its 50/h quota) ----------
# Sign up at https://www.pexels.com/api/ -- free tier: 200 requests/hour.
PEXELS_API_KEY=

# Optional: GitHub token (no scopes) to read github.com sources
# with a higher quota (60 -> 5000 requests/hour).
GITHUB_TOKEN=

# ---------- Openverse (last resort: Creative Commons photos, no key) ----------
# Without credentials: 20 requests/min and 200/day. Attribution goes in the caption.
OPENVERSE_ENABLED=true
# Only licenses allowing commercial use and modification: cc0, pdm, by, by-sa
OPENVERSE_LICENSES=cc0,pdm,by

# ---------- Image generation (swappable provider) ----------
IMAGE_GENERATION_PROVIDER=none
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_ENDPOINT=

# ---------- Behavior ----------
CONTENT_STRATEGY=html
DRAFT_FILTER=status:draft
MAX_POSTS_PER_RUN=5
CONCURRENCY=2
ALLOW_SLUG_CHANGE=false
TARGET_WORD_COUNT=1200
# Web interface language: en (default) or es. Any folder in src/i18n/locales.
UI_LANGUAGE=en

# What your blog is about: topic, audience, language and tone. Passed to every agent.
SITE_CONTEXT="Technology, software and AI blog in Spanish for a technical audience."
LOG_LEVEL=info
# Local data (runs, index, edited prompts). Defaults to .data in a repo clone.
# DATA_DIR=.data

# The writer may link 1-3 related posts already published on the blog.
# INTERNAL_LINKS=true

# Nightly plan of NEW drafts (never planned) at this local time; only plans, never applies.
# Empty = off. At most AUTO_PLAN_MAX drafts per night (default 3), within AI_DAILY_BUDGET_USD.
# AUTO_PLAN_TIME=07:00
# AUTO_PLAN_MAX=3

# Google Search Console, for the Ideas page (optional, read-only).
# Property as shown in Search Console, and a service account key (path to the JSON file).
# GSC_SITE_URL=sc-domain:example.com
# GSC_SERVICE_ACCOUNT=/path/to/service-account.json

# Bing Webmaster Tools, also for the Ideas page (optional): site URL and API key
# (Bing Webmaster → Settings → API access). Its searches are added to Google's.
# BING_SITE_URL=https://example.com/
# BING_API_KEY=

# Web UI on a server, behind a proxy/tunnel (see README "On a server").
# PUBLIC_URL=https://ghost.example.com
# Plan B for scripts only: a fixed token that logs in WITHOUT password/2FA. Leave it unset.
# WEB_SESSION_TOKEN=

# ---------- Wikimedia Commons (Wikipedia's images, no key) ----------
# WIKIMEDIA_ENABLED=true
# Licenses allowed: cc0, pdm, by, by-sa (by-sa makes derivatives share-alike).
# WIKIMEDIA_LICENSES=cc0,pdm,by

# ---------- Development only (Milestone 2+) ----------
TEST_POST_ID=
